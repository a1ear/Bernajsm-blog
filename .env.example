# ---------------------------------------------------------------------------
# Bernajsm-blog environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> Database for the connection strings,
# Project Settings -> API for the keys).
#
# Both Next.js and the Prisma CLI read `.env.local` and `.env`; `prisma.config.ts`
# loads them explicitly, with `.env.local` taking precedence.
#
# Both files are git-ignored. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (server-side only; never exposed to the browser) -------------

# Pooled connection (Supavisor, port 6543). Used by the app at runtime via the
# @prisma/adapter-pg driver adapter in lib/prisma.ts.
#
# NOTE: do NOT append `?pgbouncer=true&connection_limit=1`. Those are Prisma
# query-engine parameters. Under Prisma 7 this string is handed to
# node-postgres, which ignores both — the real pool settings (max, idle
# timeout) live in lib/prisma.ts instead.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct connection (port 5432). Used by the Prisma CLI for migrations —
# see prisma.config.ts. Migrations cannot run over the pooled connection.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth -----------------------------------------------------------

# Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# --- Supabase Storage (server-side only) ------------------------------------
#
# Used ONLY by lib/storage.ts, called ONLY from Server Actions that already
# called requireAdmin() (see app/bjsm-write/(dashboard)/posts/actions.ts,
# newsletters/actions.ts). This is what lets the `media` and `newsletters`
# buckets stay writable with zero Storage RLS policies: the browser never
# holds a credential that can write, so there's nothing for a policy to gate.
#
# Unlike truckledger, this app genuinely needs the service-role key — cover
# images, author photos and newsletter PDFs all upload through it. Never
# prefix it with NEXT_PUBLIC_ or import lib/storage.ts into a Client
# Component (it has no "use client" and isn't marked "server-only" by
# convention here the way lib/prisma.ts is — double-check before reusing it).
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Public site URL (optional) ---------------------------------------------
#
# Used for the sitemap, robots.txt and Open Graph tags. Falls back to
# http://localhost:3000 if unset — set this before deploying so those don't
# point at localhost in production.
# NEXT_PUBLIC_SITE_URL="https://your-real-domain.com"
